//solution 2 :
class Solution {
        public int removeDuplicates(int[] nums) {
            int count = 0;
            int j = 0;
            int n = nums.length;
            int res = 0;
            for(int i=0; i<n; i++) {
                if(i==j) {
                    count = 0;
                }
                if(nums[i]==30001) {
                    continue;
                }
                while (j<n && nums[i] == nums[j]){
                    j++;
                    count ++;
                }
                if(count > 2) {
                    nums[i]=30001;
                    count--;
                }
            }
            int k = 0;
            for(int i=0; i<nums.length; i++) {
                if(nums[i]!=30001) {
                    int c = nums[i];
                    nums[i] = nums[k];
                    nums[k] = c;
                    k++;
                }
            }
            for(int i=nums.length-1; i>=0; i--) {
                res = i;
                if(nums[i] != 30001) {
                    break;
                }
            }
            return res+1;
        }
}
